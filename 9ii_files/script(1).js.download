e.\",\"gmbPublishMessage\":\"Your website needs to be published before connecting to Google My Business.\",\"sourceMsgStatic\":\"Add reviews manually\",\"manualReviews\":\"Reviews\",\"ratingNone\":\"None\",\"reviewRating\":\"Rating\",\"percentRecommend\":\"{percent} recommend\",\"connectMsg\":\"To show reviews on your site, connect your account to {provider}\",\"twentyFourHourLag\":\"Data may take up to 24 hours to display.\",\"recommends\":\"Recommends\",\"reviewFirst\":\"Be the first to leave a review\",\"review\":\"{totalReviews} Review\",\"publishMessage\":\"Your website needs to be published before connecting to {provider}\",\"sourceMsgDynamic\":\"Connect to external source\",\"reviewBody\":\"Review\",\"upgradeNow\":\"Add Store Now\",\"viewMore\":\"View More\",\"reviews\":\"{totalReviews} Reviews\",\"cantConnectMsg\":\"Your website needs to be published before connecting to {provider}\",\"comingSoon\":\"Reviews coming soon!\",\"readFullReview\":\"Read full review\",\"labelForDeleteManualReview\":\"Delete Review\",\"gmbNoReviews\":\"You are successfully connected but there are no reviews yet.\",\"connectBtnText\":\"Connect to {provider}\",\"viewAllReviews\":\"View All {totalReviews} Reviews\"},\"websiteId\":\"d279ec96-7274-4344-9c88-29c5c4d84b12\",\"sourceType\":\"static\",\"manualReviews\":[{\"photo\":{},\"title\":\"Easy\",\"body\":\"Putting this on was pretty trivial and it seems well made, I wish it was cheaper but I got a free pre-production sample to test out\",\"rating\":\"4\",\"name\":\"Jon from Wisconsin\",\"date\":\"11/28/2023\"},{\"photo\":{},\"title\":\"Nicely made\",\"body\":\"I have had to change the oil filler tube twice before due to it splitting, it gets hot here in Houston which kills the tubes quicker. Now I don't have to do it a third time.\",\"rating\":\"5\",\"name\":\"Steve\",\"date\":\"11/20/2023\"},{\"photo\":{},\"title\":\"Finally\",\"body\":\"I regularly check my water pump as they are fragile on 996 cars, it means taking off the serpentine belt and air filter. Now I don't worry about breaking the dumb 996 oil filler tube.\",\"rating\":\"5\",\"name\":\"Geoff, Portland\",\"date\":\"05/12/2023\"}],\"widgetId\":\"c1ddfbdd-fff5-41dd-b176-ca66b680bfa8\",\"section\":\"alt\",\"category\":\"neutral\",\"locale\":\"en-US\",\"env\":\"production\",\"renderMode\":\"PUBLISH\"}"),context:JSON.parse("{\"order\":5,\"widgetId\":\"c1ddfbdd-fff5-41dd-b176-ca66b680bfa8\",\"widgetType\":\"REVIEWS\",\"widgetPreset\":\"reviews1\",\"group\":\"Section\",\"groupType\":\"Banner\",\"section\":\"alt\",\"category\":\"neutral\",\"fontSize\":\"medium\",\"fontFamily\":\"alternate\",\"websiteThemeOverrides\":{\"ButtonPrimary\":{\"value\":{\"color\":\"PRIMARY\",\"fill\":\"SOLID\",\"shape\":\"PILL\",\"decoration\":\"NONE\",\"shadow\":\"NONE\",\"size\":\"default\"}},\"ButtonSpotlight\":{\"value\":{\"shape\":\"PILL\",\"decoration\":\"NONE\",\"shadow\":\"NONE\"}},\"ButtonExternal\":{\"value\":{\"shape\":\"PILL\"}},\"ButtonSecondary\":{\"value\":{\"shape\":\"PILL\",\"decoration\":\"NONE\",\"shadow\":\"NONE\"}}},\"widgetThemeOverrides\":{}}"),contextKey:'context-bs-9',radpack:"@widget/REVIEWS/bs-Component"},false);
